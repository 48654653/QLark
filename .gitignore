# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境
.venv/
venv/

# IDE
.idea/
.vscode/

# NapCat 运行时依赖（约 300MB，不纳入源码管理）
runtime/

# 本地数据 / 日志 / 临时文件
*.log
*.bak
/tmp/
/data/

# ---------------------------------------------------------------------------
# 以下不随源码发布
#
# 表情包素材：仓库里只保留放置说明，图片请自备（文件名 = 情绪名）。
# 这些是角色美术素材，版权不在本项目，公开仓库不适合携带。
/memes/*.png
/memes/*.jpg
/memes/*.jpeg
/memes/*.gif
/memes/*.webp

# 开发过程的界面截图：截图里带着真实的 QQ 号（窗口标题栏和侧边栏），
# 会泄露使用者账号，所以不纳入仓库。需要时用 tools/showcase.py 重新生成。
/docs/*.png

# 人设内容备份（含个人设定文字）
/personas-backup.json
